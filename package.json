{
  "name": "com.davidhellmann.sveltekit",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "svelte-kit sync && NODE_OPTIONS=--use-system-ca concurrently \"npm run codegen --watch\" \"vite dev\"",
    "build": "svelte-kit sync && vite build",
    "preview": "NODE_OPTIONS=--use-system-ca vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "codegen": "NODE_OPTIONS=--use-system-ca graphql-codegen --require dotenv/config --config codegen.ts",
    "icons:add": "npx @sly-cli/sly add --overwrite",
    "a": "sh ./scripts/scopes-all.sh",
    "f": "sh ./scripts/scopes-focus.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/eslint": "^9.6.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "embla-carousel": "^8.6.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shiki": "^4.5.0",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-time": "^2.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-svg-sprite-wrapper": "^1.5.0",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "dependencies": {
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@parcel/watcher": "^2.6.0",
    "@sly-cli/sly": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "gsap": "^3.15.0",
    "lightgallery": "3.0.0",
    "lodash-es": "^4.18.1",
    "node-html-parser": "^9.0.5",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "unlazy": "^2.0.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
